# Zimdalo — configuration Apache pour hébergement Hostinger
# Le routage interne est basé sur window.location.hash (#/...), donc aucune
# règle de réécriture d'URL n'est nécessaire : toutes les routes se résolvent
# côté client à partir du même index.html.

# Compression des assets texte
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache navigateur pour les assets versionnés (générés par Vite avec hash dans le nom de fichier)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Force HTTPS (à activer une fois le certificat SSL Hostinger actif)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
